{
  "manifest_version": 3,
  "name": "West VPN Client",
  "version": "1.4.0",
  "description": "Клиент маршрутизации VPN и прокси для Chrome, Cent Browser и LibreWolf с поддержкой режима задач Gemini (США), раздельной привязкой серверов по сайтам, защитой локальной сети и zapret-совместимостью",
  "browser_specific_settings": {
    "gecko": {
      "id": "west-vpn-client@wild.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "default_data.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "West VPN Client",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
