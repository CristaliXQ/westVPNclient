[Unit]
Description=West VPN Client Background Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/west-vpn-client/core
ExecStart=/usr/bin/env python3 west_service.py
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=default.target
